# Required
SHOPIFY_APP_SECRET=        # the app's Client secret (App Proxy signing, session tokens, webhook HMAC)
SHOPIFY_CLIENT_ID=         # the app's Client ID (embedded dashboard session tokens, token exchange)

# Recommended
SHOPIFY_SHOP_DOMAIN=       # pin the app to one store's myshopify.com domain, e.g. healtence.myshopify.com

# Optional, but required for correct behavior once this runs as more than one function instance
# (multiple Vercel regions, or any real traffic): without these, the tracking cache, the Cainiao
# rate limiter, and the Shopify offline-token cache all fall back to in-memory state that is
# local to a single warm instance and is lost on every cold start. Get these from an Upstash
# Redis database (https://upstash.com) — the free tier is enough for this app's traffic shape.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional
HIDE_ORIGIN_COUNTRY=       # "1"/"true" to omit the shipment's origin country from storefront responses
